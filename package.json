{
  "name": "sige-ruth",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SIGE Ruth - Sistema Interno de Gestión Escolar",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "bash scripts/test-rls.sh",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "security:secrets": "bash scripts/check-secrets.sh",
    "security:privacy": "bash scripts/check-privacy.sh",
    "deploy:admin-users": "npx --no-install supabase functions deploy admin-users",
    "seed:data": "node scripts/seed_from_json.js"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.4.0",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-query": "^5.97.0",
    "lucide-react": "^1.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/react-query-devtools": "^5.97.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.12.0",
    "supabase": "2.116.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.11"
  }
}
